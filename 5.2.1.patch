+    private File renderOrGetImage(String productCode, String view, List<DrapeData> parts, double scale, File imageFile) throws Exception {
+        if (imageFile.exists()) {
+            return imageFile;
+        }
+        RenderLock renderLock = acquireRenderLock(imageFile);
+        synchronized (renderLock.monitor) {
+            try {
+                if (imageFile.exists()) {
+                    return imageFile;
+                }
+                if (scale == 1) {
+                    return ImageUtils.mergeImage(DrapeUtils.renderAll(FileUtils.createDrapeData(productCode, view, parts)), imageFile);
+                }
+                File renderedImageFile = FileUtils.getMD5Image(productCode, view, parts, 1.0);
+                File sourceFile = renderOrGetImage(productCode, view, parts, 1.0, renderedImageFile);
+                return ImageUtils.compressImage(sourceFile, imageFile, scale);
+            } finally {
+                releaseRenderLock(imageFile, renderLock);
+            }
+        }
+    }
+
+    private RenderLock acquireRenderLock(File imageFile) {
+        return RENDER_LOCKS.compute(imageFile.getAbsolutePath(), (key, current) -> {
+            if (current == null) {
+                current = new RenderLock();
+            }
+            current.refCount++;
+            return current;
+        });
+    }
+
+    private void releaseRenderLock(File imageFile, RenderLock renderLock) {
+        RENDER_LOCKS.computeIfPresent(imageFile.getAbsolutePath(), (key, current) -> {
+            if (current != renderLock) {
+                return current;
+            }
+            current.refCount--;
+            return current.refCount == 0 ? null : current;
+        });
+    }
+
+    private static class RenderLock {
+        private final Object monitor = new Object();
+        private int refCount;
+    }
